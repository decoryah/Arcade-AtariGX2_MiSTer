set_global_assignment -name SYSTEMVERILOG_FILE AtariGX2.sv
set_global_assignment -name SDC_FILE AtariGX2.sdc
set_global_assignment -name QIP_FILE rtl/pll/pll.qip
set_global_assignment -name SEARCH_PATH rtl

# the machine
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gx2_main.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gx2_xga.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gx2_video.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gx2_jsa.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gx2_inputs.sv

# from the Primal Rage core (MiSTer-devel/Arcade-PrimalRage_MiSTer, GPL-3; rtl/UPSTREAM.md)
set_global_assignment -name SYSTEMVERILOG_FILE rtl/rle_objects.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/tdp_ram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/rom_ddr_replay.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/nvram_hps.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gx2_loader.sv

# platform: CRT Adjust (rmonic79's line buffer, modules/crt_adjust)
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gx2_crtadj.sv
set_global_assignment -name SYSTEMVERILOG_FILE modules/crt_adjust/crt_adjust.sv

# 68EC020: TG68K.C (Tobias Gubener, LGPL-3), Verilog generated from the VHDL by GHDL (tools/gen_vhdl_cores.sh)
set_global_assignment -name VERILOG_FILE modules/cpu-tg68k/gen/tg68k.v

# JSA IIIs: T65 (6502, GHDL-generated as above), jt51 (YM2151), jt6295 (OKI6295)
